{
    "git.ignoreLimitWarning": true,

    // Python Virtual Environment Configuration
    "python.defaultInterpreterPath": "${workspaceFolder}/services/game-api/.venv/Scripts/python.exe",
    "python.venvPath": "${workspaceFolder}/services",
    "python.venvFolders": [
        "${workspaceFolder}/services/game-api",
        "${workspaceFolder}/services/admin-api",
        "${workspaceFolder}/services/data-sync"
    ],

    // Python Analysis
    "python.analysis.extraPaths": [
        "./services/game-api",
        "./services/admin-api",
        "./services/data-sync",
        "./shared"
    ],
    "python.analysis.autoImportCompletions": true,

    // Python Linting - Use Ruff instead of flake8
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": false,
    "python.linting.ruffEnabled": true,
    "python.linting.mypyEnabled": true,
    "python.linting.banditEnabled": true,

    // Python Formatting - Use Ruff instead of Black
    "python.formatting.provider": "none",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },

    // Editor Settings
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/__pycache__": true
    },
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/shared"
    },
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/shared"
    },
    "terminal.integrated.env.osx": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/shared"
    }
}