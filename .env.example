# Database Configuration
DATABASE_URL=postgresql://gameuser:gamepass@postgres:5432/gamecalendar

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# IGDB API Credentials
# Get your credentials from: https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=your_client_id_here
IGDB_CLIENT_SECRET=your_client_secret_here

# Admin API Authentication
# Generate a secure token: openssl rand -hex 32
ADMIN_TOKEN=change_me_in_production

# CORS — comma-separated list of allowed frontend origins. Default "*".
# In production set this to your real frontend URL(s), e.g.
#   CORS_ORIGINS=https://calendar.example.com
CORS_ORIGINS=*

# Environment
NODE_ENV=development
PYTHON_ENV=development
